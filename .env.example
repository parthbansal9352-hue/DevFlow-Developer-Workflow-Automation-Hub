# DevFlow Environment Configuration
# Copy this file to .env and provide your Appwrite instance details

# Appwrite Server Endpoint (Cloud: https://cloud.appwrite.io/v1 or your self-hosted instance)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Appwrite Project ID (Found in your Appwrite console project settings)
VITE_APPWRITE_PROJECT_ID=your_appwrite_project_id

# Appwrite Database ID
VITE_APPWRITE_DATABASE_ID=devflow_db

# TablesDB / Collections IDs
VITE_APPWRITE_TABLE_PROJECTS=projects
VITE_APPWRITE_TABLE_TASKS=tasks
VITE_APPWRITE_TABLE_AUTOMATION_RULES=automation_rules
VITE_APPWRITE_TABLE_ACTIVITY_LOGS=activity_logs
VITE_APPWRITE_TABLE_NOTIFICATIONS=notifications

# Optional: Default GitHub organization/user or public repo for developer activity feed
VITE_GITHUB_DEFAULT_REPO=facebook/react

# SECURITY NOTICE:
# DO NOT place Appwrite Server API keys or GitHub Personal Access Tokens here.
# Frontend applications must only access Appwrite via Client sessions and row-level permissions.
